{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "../.verify",
    "rootDir": "../src",
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "../src/types.ts",
    "../src/utils.ts",
    "../src/theme.ts",
    "../src/domain/**/*.ts",
    "../src/ai/**/*.ts",
    "../src/data/**/*.ts",
    "../src/db/**/*.ts",
    "../src/__tests__/**/*.ts"
  ]
}